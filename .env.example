# Server settings
HOST=127.0.0.1
PORT=8000

# Comma-separated allowed origins. Leave empty for same-origin only.
CORS_ORIGINS=

# Relative data paths (resolved from project root)
PROCUREMENT_PLAYBOOK_DIR=playbook/playbook
PROCUREMENT_THREADS_CSV=threads.csv
PROCUREMENT_SAMPLE_THREADS_CSV=sample_threads.csv
PROCUREMENT_SAMPLE_ANSWERS_CSV=sample_answers.csv
PROCUREMENT_SUBMISSION_FINAL_CSV=submission_final.csv
PROCUREMENT_UI_DIR=ui

# Batch upload safety limits
MAX_BATCH_BYTES=5242880
MAX_BATCH_ROWS=5000
JOB_TTL_SECONDS=3600
