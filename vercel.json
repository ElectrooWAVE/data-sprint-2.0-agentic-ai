{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "app/**",
          "src/**",
          "playbook/**",
          "sample_threads.csv",
          "sample_answers.csv",
          "sample_submission.csv",
          "threads.csv",
          "submission_final.csv"
        ]
      }
    },
    {
      "src": "ui/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/data/(.*)", "dest": "/ui/data/$1" },
    { "src": "/(styles\\.css|app\\.js)", "dest": "/ui/$1" },
    { "src": "/assets/(.*)", "dest": "/ui/assets/$1" },
    { "src": "/(.*)", "dest": "/ui/index.html" }
  ]
}
